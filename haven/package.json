{
  "name": "haven",
  "version": "1.0.0",
  "private": true,
  "description": "Haven - a self-hosted family wall calendar, chore chart and household hub for a Raspberry Pi.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "TZ=America/New_York vitest run",
    "test:e2e": "playwright test",
    "seed:demo": "tsx src/server/seed.ts",
    "reset-pin": "tsx src/server/reset-pin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "imapflow": "^2.3.0",
    "mailparser": "^3.9.37",
    "node-ical": "^0.20.1",
    "rrule": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
